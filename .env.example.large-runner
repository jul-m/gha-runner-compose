######## Required ########
RUNNER_REPO_URL=https://github.com/jul-m/gha-runner-compose
RUNNER_TOKEN=<registration_token>

# Labels required by the large-tiers CI jobs (one per architecture) - do not rename.
# A single runner carrying both labels builds the two flows one after the other; register one runner
# per label to run them in parallel.
RUNNER_LABELS=gha-runner-compose-large-images-amd64,gha-runner-compose-large-images-arm64
